[Unit]
Description=WeatherDash - Davis WeatherLink Live dashboard and recorder
After=network-online.target
Wants=network-online.target

[Service]
# Change these three lines to match your setup
User=pi
WorkingDirectory=/home/pi/weatherdash
Environment=WLL_HOST=192.168.1.47
Environment=STATION_NAME=Home Station
# Optional, for backfilling gaps from WeatherLink.com (needs a Pro subscription)
#Environment=WL_API_KEY=your-key
#Environment=WL_API_SECRET=your-secret
ExecStart=/usr/bin/python3 /home/pi/weatherdash/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
